      }
    },
    {
      "type": "timeseries",
      "title": "컨테이너 파일시스템 사용",
      "description": "Elasticsearch 색인과 Postgres 데이터가 쌓이는 곳. 디스크가 차면 ES가 read-only로 전환되어 색인이 멈춘다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (container_fs_usage_bytes{name=~\"rag-.+\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
