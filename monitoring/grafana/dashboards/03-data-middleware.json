{
  "uid": "rag-data",
  "title": "03. Data & Middleware - DB·캐시·검색",
  "description": "Postgres, Redis, Elasticsearch를 '앱이 겪는 관점'에서 본다. 전용 exporter 대신 앱 측 지표를 쓰는 이유는 docs/OBSERVABILITY.md 참고.",
  "tags": [
    "data"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "DB 커넥션 풀 (HikariCP)",
      "description": "'대기 중'이 0보다 크면 커넥션이 모자라 요청이 줄 서고 있다는 뜻이다. DB가 느린 것과 풀이 작은 것을 구분하는 핵심 지표.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"confluence-rag-chatbot-backend\"}",
          "legendFormat": "active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "hikaricp_connections_idle{application=\"confluence-rag-chatbot-backend\"}",
          "legendFormat": "idle",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "hikaricp_connections_max{application=\"confluence-rag-chatbot-backend\"}",
          "legendFormat": "max",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "hikaricp_connections_pending{application=\"confluence-rag-chatbot-backend\"}",
          "legendFormat": "대기 중",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 획득/점유 시간",
      "description": "획득 시간이 길면 풀 고갈, 점유 시간이 길면 쿼리 자체가 느린 것이다.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"confluence-rag-chatbot-backend\"}[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{application=\"confluence-rag-chatbot-backend\"}[5m]), 0.001)",
          "legendFormat": "획득 시간",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(hikaricp_connections_usage_seconds_sum{application=\"confluence-rag-chatbot-backend\"}[5m]) / clamp_min(rate(hikaricp_connections_usage_seconds_count{application=\"confluence-rag-chatbot-backend\"}[5m]), 0.001)",
          "legendFormat": "점유 시간",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "대화 이력 캐시 적중률 (Redis)",
      "description": "적중률이 낮으면 Redis TTL(30분)이 실제 대화 간격보다 짧아 매 턴 Postgres를 때리고 있다는 뜻이다. 지연 상승의 조용한 원인이 된다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(chat_history_cache_total{result=\"hit\"}[10m])) / clamp_min(sum(rate(chat_history_cache_total[10m])), 0.001)",
          "legendFormat": "적중률",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Elasticsearch 검색 지연 (앱 측정)",
      "description": "ES 내부 수치가 아니라 앱이 실제로 기다린 시간. 네트워크와 직렬화까지 포함해 '우리가 겪는 ES 지연'을 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_stage_duration_seconds_bucket{stage=\"search\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_stage_duration_seconds_bucket{stage=\"search\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_stage_duration_seconds_bucket{stage=\"search\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "검색 0건 비율",
      "description": "검색이 0건을 돌려주면 답변은 반드시 실패한다. 지연이 아닌 '조용한 실패'를 잡는 지표다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(rag_retrieved_documents_bucket{le=\"0\"}[10m])) / clamp_min(sum(rate(rag_retrieved_documents_count[10m])), 0.001)",
          "legendFormat": "0건 비율",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "데이터 계층 컨테이너 자원",
      "description": "ES는 mem_limit 2g로 가장 빡빡하다. 메모리가 한계에 붙으면 검색 지연이 먼저 오른다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"rag-(postgres|redis|elasticsearch)\"}[5m]))",
          "legendFormat": "CPU {{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\"rag-(postgres|redis|elasticsearch)\"}) / sum by (name) (container_spec_memory_limit_bytes{name=~\"rag-(postgres|redis|elasticsearch)\"} > 0)",
          "legendFormat": "MEM% {{name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    }
  ]
}