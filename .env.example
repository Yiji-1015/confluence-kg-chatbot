# ===== LLM 키 (LiteLLM이 사용) =====
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# UPSTAGE_API_KEY: 평가 채점 전용 모델(solar-judge). 생성 모델과 분리하기 위해 사용
UPSTAGE_API_KEY=

# ===== Elasticsearch (ELASTICSEARCH.md 기준: TLS + 인증 필수) =====
# ELASTIC_PASSWORD: docker-compose(es-setup/elasticsearch/kibana)가 사용
# ELASTICSEARCH_PASSWORD: ai-server(app/config.py)가 사용 — 같은 값으로 유지
ELASTIC_PASSWORD=변경하세요
ELASTICSEARCH_PASSWORD=변경하세요
# KIBANA_PASSWORD: kibana_system 전용 계정 (elastic superuser는 Kibana가 사용 불가)
KIBANA_PASSWORD=변경하세요
ES_MEMORY_LIMIT=2g

# ===== 검색 튜닝 (재색인 불필요, 컨테이너 재시작만 하면 반영) =====
# RETRIEVAL_TOP_K: 컨텍스트에 넣을 서로 다른 문서 수
# RETRIEVAL_CANDIDATE_SIZE: BM25/kNN이 각각 가져올 재랭킹 후보 청크 수
# DOC_CONTEXT_MAX_CHARS: 문서 하나당 컨텍스트에 넣을 최대 글자 수
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_SIZE=50
DOC_CONTEXT_MAX_CHARS=3000
# RRF_K: 순위 결합 상수. 각 리스트의 순위로 1/(RRF_K+순위)를 계산해 더한다.
#        작을수록 상위권 우대, 클수록 양쪽에 고루 든 문서 우대. 60이 표준값.
RRF_K=60
# RECENCY_BOOST_MAX: 최신 문서 가산점. 이론상 최대 결합 점수에 대한 비율 (0=끔, 0.04=4%)
RECENCY_BOOST_MAX=0.04
# LLM_TEMPERATURE: 0=결정적(평가 재현성). 미지정 시 모델 기본값은 1.0이라 답이 매번 달라진다
LLM_TEMPERATURE=0
# JUDGE_MODEL: 채점 모델. 반드시 답변 생성 모델과 다른 계열로 둘 것
JUDGE_MODEL=solar-judge

CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=SPACE_KEY
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-api-token

LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
